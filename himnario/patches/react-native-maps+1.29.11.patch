+static void applyRNMapsPreferredConfiguration(AIRMap *mapView, RNMapsMapViewMapType rnMapType) {
+    if (@available(iOS 16.0, *)) {
+        MKPointOfInterestFilter *existingFilter = nil;
+        BOOL existingTraffic = mapView.showsTraffic;
+        if ([mapView.preferredConfiguration isKindOfClass:[MKStandardMapConfiguration class]]) {
+            MKStandardMapConfiguration *prev = (MKStandardMapConfiguration *)mapView.preferredConfiguration;
+            existingFilter = prev.pointOfInterestFilter;
+            existingTraffic = prev.showsTraffic;
+        } else if ([mapView.preferredConfiguration isKindOfClass:[MKHybridMapConfiguration class]]) {
+            MKHybridMapConfiguration *prev = (MKHybridMapConfiguration *)mapView.preferredConfiguration;
+            existingFilter = prev.pointOfInterestFilter;
+            existingTraffic = prev.showsTraffic;
+        }
+
+        MKMapConfiguration *config = nil;
+        switch (rnMapType) {
+            case RNMapsMapViewMapType::Satellite:
+            case RNMapsMapViewMapType::SatelliteFlyover: {
+                config = [[MKImageryMapConfiguration alloc] initWithElevationStyle:MKMapElevationStyleRealistic];
+                break;
+            }
+            case RNMapsMapViewMapType::Hybrid:
+            case RNMapsMapViewMapType::HybridFlyover: {
+                MKHybridMapConfiguration *hybrid = [[MKHybridMapConfiguration alloc] initWithElevationStyle:MKMapElevationStyleRealistic];
+                hybrid.showsTraffic = existingTraffic;
+                if (existingFilter) {
+                    hybrid.pointOfInterestFilter = existingFilter;
+                }
+                config = hybrid;
+                break;
+            }
+            case RNMapsMapViewMapType::MutedStandard: {
+                MKStandardMapConfiguration *muted = [[MKStandardMapConfiguration alloc] initWithElevationStyle:MKMapElevationStyleRealistic emphasisStyle:MKStandardMapEmphasisStyleMuted];
+                muted.showsTraffic = existingTraffic;
+                if (existingFilter) {
+                    muted.pointOfInterestFilter = existingFilter;
+                }
+                config = muted;
+                break;
+            }
+            case RNMapsMapViewMapType::Standard:
+            default: {
+                MKStandardMapConfiguration *standard = [[MKStandardMapConfiguration alloc] initWithElevationStyle:MKMapElevationStyleRealistic emphasisStyle:MKStandardMapEmphasisStyleDefault];
+                standard.showsTraffic = existingTraffic;
+                if (existingFilter) {
+                    standard.pointOfInterestFilter = existingFilter;
+                }
+                config = standard;
+                break;
+            }
+        }
+        mapView.preferredConfiguration = config;
+    } else {
+        mapView.mapType = mapRNTypeToMKMapType(rnMapType);
+    }
