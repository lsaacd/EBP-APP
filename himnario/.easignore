# dependencies
node_modules/
node_modules/**/*

# Expo
.expo/
.expo/**/*
dist/
dist/**/*
web-build/
web-build/**/*

# Native build folders (these are HUGE and not needed for cloud builds)
android/
android/**/*
ios/
ios/**/*

# Build artifacts
.kotlin
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# git
.git

# scratch folders
scratch

# example
app-example

# NOTE: do not ignore assets/audio here. iOS bundles those recordings and its build
# would fail without them. Android build scripts (build-android-*.ps1) exclude the
# audio folder only for the duration of an Android build.

