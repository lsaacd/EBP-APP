/android/**/*
/ios/
/ios/**/*

# Build artifacts
.kotlin
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
._*
*.pem

# local env files
.env*.local
.env
.env.*
.dev.vars
.dev.vars.*
credentials.json
token.json

# typescript
*.tsbuildinfo

# git
.git

# scratch folders
/scratch
/scratch/**/*

