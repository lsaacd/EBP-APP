{
  "cli": {
    "version": ">= 20.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "channel": "ios-simulator"
    },
    "ios-simulator-release": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "resourceClass": "large"
      },
      "channel": "production"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "large"
      },
      "android": {
        "resourceClass": "large"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "large"
      },
      "android": {
        "resourceClass": "large"
      },
      "channel": "production"
    },
    "preview-arm64": {
      "extends": "preview",
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "security-test-ios": {
      "extends": "production",
      "channel": "security-test-v2",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_AUTH_SYNC_API_URL": "https://ebp-himnario-sync-security.himnario.workers.dev"
      }
    },
    "security-test-android": {
      "extends": "preview-arm64",
      "channel": "security-test-v2",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_AUTH_SYNC_API_URL": "https://ebp-himnario-sync-security.himnario.workers.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6794435414"
      }
    }
  }
}
