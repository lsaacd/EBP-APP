{
  "expo": {
    "name": "Himnario El Buen Pastor",
    "slug": "himnario",
    "version": "1.0.0",
    "scheme": "himnario",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/white-ios-logo.png",
    "ios": {
      "icon": "./assets/images/AppIcon.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.iddvelbuenpastor.himnario",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.iddvelbuenpastor.himnario",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/white-ios-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo-light.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FCF9F2",
          "dark": {
            "image": "./assets/images/splash-logo-dark.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-font",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0fdffbe6-ab68-4d61-ab66-491b42a634b2"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0fdffbe6-ab68-4d61-ab66-491b42a634b2"
    }
  }
}
