{
  "expo": {
    "name": "Himnario El Buen Pastor",
    "slug": "ElBuenPastorHimnario",
    "version": "2.1.0",
    "orientation": "default",
    "icon": "./assets/images/android-legacy-app-logo.png",
    "scheme": "el-buen-pastor-himnario",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/AppIcon.icon",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleLocalizations": [
          "es",
          "en"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Permite tomar fotos del templo para sugerir o verificar una iglesia en el directorio y escanear códigos QR de himnos o iglesias.",
        "NSPhotoLibraryUsageDescription": "Permite adjuntar fotos existentes del templo desde tu galería al sugerir o actualizar una iglesia en el directorio."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      },
      "bundleIdentifier": "com.elbuenpastor",
      "associatedDomains": [
        "applinks:himnarioebp.com",
        "applinks:www.himnarioebp.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF5EE",
        "backgroundImage": "./assets/images/android-background-app-logo.png",
        "foregroundImage": "./assets/images/android-foreground-app.png",
        "monochromeImage": "./assets/images/android-monochrome-app-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.elbuenpastor.himnario",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/white-ios-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/EBP-LOGO1.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FAF5EE",
          "dark": {
            "backgroundColor": "#010101"
          },
          "android": {
            "image": "./assets/images/SPLASH-SCREEN-ANDROID.png",
            "backgroundColor": "#FAF5EE",
            "dark": {
              "backgroundColor": "#010101"
            }
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-build-properties",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite encontrar iglesias verificadas El Buen Pastor cerca de tu ubicación.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite tomar fotos del templo para sugerir o verificar una iglesia en el directorio y escanear códigos QR de himnos o iglesias.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite adjuntar fotos existentes del templo desde tu galería al sugerir o actualizar una iglesia en el directorio.",
          "cameraPermission": "Permite tomar fotos del templo para sugerir o verificar una iglesia en el directorio y escanear códigos QR de himnos o iglesias.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-monochrome-app-logo.png",
          "color": "#7B1E26"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74ef3b4c-fe90-4c2c-8521-b52f4b6a5441"
      }
    },
    "owner": "isaacduran",
    "runtimeVersion": "2.1.0-sdk58-1",
    "updates": {
      "url": "https://u.expo.dev/74ef3b4c-fe90-4c2c-8521-b52f4b6a5441"
    }
  }
}
