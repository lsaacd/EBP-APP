{
  "expo": {
    "name": "Himnario El Buen Pastor",
    "slug": "ElBuenPastorHimnario",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/images/android-legacy-app-logo.png",
    "scheme": [
      "el-buen-pastor-himnario",
      "com.googleusercontent.apps.242867050819-vgirqp4m77rrthvhis46kbiajmcg9qce"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "icon": "./assets/images/AppIcon.icon",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "es"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allows taking photos of a church building to suggest or verify a church in the directory and scanning hymn or church QR codes.",
        "NSPhotoLibraryUsageDescription": "Allows attaching existing photos from your photo library when updating your profile photo or suggesting a church in the directory.",
        "NSLocationWhenInUseUsageDescription": "Allows finding verified El Buen Pastor churches near your location."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      },
      "bundleIdentifier": "com.elbuenpastor",
      "associatedDomains": [
        "applinks:himnarioebp.com",
        "applinks:www.himnarioebp.com",
        "webcredentials:himnarioebp.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF5EE",
        "backgroundImage": "./assets/images/android-background-app-logo.png",
        "foregroundImage": "./assets/images/android-foreground-app.png",
        "monochromeImage": "./assets/images/android-monochrome-app-logo.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.elbuenpastor.himnario",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            { "scheme": "https", "host": "himnarioebp.com", "pathPrefix": "/h/" },
            { "scheme": "https", "host": "himnarioebp.com", "pathPrefix": "/hymn/" },
            { "scheme": "https", "host": "himnarioebp.com", "pathPrefix": "/himno/" },
            { "scheme": "https", "host": "himnarioebp.com", "pathPrefix": "/member" },
            { "scheme": "https", "host": "himnarioebp.com", "pathPrefix": "/churches" },
            { "scheme": "https", "host": "www.himnarioebp.com", "pathPrefix": "/h/" },
            { "scheme": "https", "host": "www.himnarioebp.com", "pathPrefix": "/hymn/" },
            { "scheme": "https", "host": "www.himnarioebp.com", "pathPrefix": "/himno/" },
            { "scheme": "https", "host": "www.himnarioebp.com", "pathPrefix": "/member" },
            { "scheme": "https", "host": "www.himnarioebp.com", "pathPrefix": "/churches" }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/white-ios-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/EBP-LOGO1.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FAF5EE",
          "dark": {
            "backgroundColor": "#010101"
          },
          "android": {
            "image": "./assets/images/SPLASH-SCREEN-ANDROID.png",
            "backgroundColor": "#FAF5EE",
            "dark": {
              "backgroundColor": "#010101"
            }
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-build-properties",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allows finding verified El Buen Pastor churches near your location.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allows taking photos of a church building to suggest or verify a church in the directory and scanning hymn or church QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allows attaching existing photos from your photo library when updating your profile photo or suggesting a church in the directory.",
          "cameraPermission": "Allows taking photos of a church building to suggest or verify a church in the directory and scanning hymn or church QR codes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-monochrome-app-logo.png",
          "color": "#7B1E26"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-apple-authentication",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.elbuenpastor.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.elbuenpastor",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "DailyVerseWidget",
              "displayName": "Versículo del Día",
              "description": "Un versículo diario de las Escrituras en tu pantalla de inicio.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": true,
              "android": {
                "minWidth": 180,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./widgets/DailyVerseWidget.android.tsx"
              }
            }
          ]
        }
      ],
      "./plugins/withWidgetContainerBackground",
      "expo-app-intents"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    },
    "extra": {
      "router": {},
      "googleIosClientId": "242867050819-vgirqp4m77rrthvhis46kbiajmcg9qce.apps.googleusercontent.com",
      "eas": {
        "projectId": "74ef3b4c-fe90-4c2c-8521-b52f4b6a5441"
      }
    },
    "owner": "isaacduran",
    "runtimeVersion": "2.0.0-sdk58-1",
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    },
    "updates": {
      "url": "https://u.expo.dev/74ef3b4c-fe90-4c2c-8521-b52f4b6a5441"
    }
  }
}
