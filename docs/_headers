# Revalidate website files so releases do not mix old controls with new markup.
# Recordings are hosted separately in R2 and are unaffected.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

# DENY prevents framing our pages; embedded Google Forms remain allowed.
# Keep CSP unenforced until script, font, media and form dependencies are validated.

/.well-known/apple-app-site-association
  Content-Type: application/json
  Access-Control-Allow-Origin: *

# Account links carry one-use secrets in the URL fragment, consumed only by an explicit action.
# Cover both /account.html and its Cloudflare Pages clean-URL target /account.
/account
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src https://ebp-himnario-sync.himnario.workers.dev https://ebp-himnario-sync-security.himnario.workers.dev; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  X-Robots-Tag: noindex, nofollow, noarchive

/account.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src https://ebp-himnario-sync.himnario.workers.dev https://ebp-himnario-sync-security.himnario.workers.dev; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  X-Robots-Tag: noindex, nofollow, noarchive
