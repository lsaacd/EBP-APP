{
  "name": "ebp-himnario-sync",
  "main": "index.js",
  "compatibility_date": "2026-03-01",
  "vars": {
    "EMAIL_ENABLED": "true",
    "EMAIL_FROM": "Himnario El Buen Pastor <cuenta@auth.himnarioebp.com>",
    "ACCOUNT_ACTION_URL": "https://himnarioebp.com/account.html",
    "APPLE_CLIENT_IDS": "com.elbuenpastor",
    "GOOGLE_CLIENT_IDS": "242867050819-vgirqp4m77rrthvhis46kbiajmcg9qce.apps.googleusercontent.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "cuenta@auth.himnarioebp.com"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ebp-himnario-db",
      "database_id": "ed683396-bfd7-43ff-b69e-f82cf4621c55",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "ebp-himnario-audio"
    }
  ]
}
