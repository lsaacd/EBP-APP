# Root .easignore — keeps EAS Build uploads small (~5 MB) instead of packing
# the live website (docs/), R2-streamed audio recordings, and git history.

# Git & local caches
.git
.git/
.wrangler/
.wrangler-cache/
.cloudflare-pages-stage/
.cursor/
.vscode/
.codex-remote-attachments/
scratch/
__pycache__/
*.pyc
*.log
logcat.txt
desktop.ini
.DS_Store

# Website, backend worker, scripts, and internal docs (not used by mobile build)
docs/
workers/
guides/
scripts/
icon-composer-svgs/

# Dependencies & Expo build output
node_modules/
himnario/node_modules/
.expo/
himnario/.expo/
dist/
himnario/dist/
web-build/
himnario/web-build/
himnario/.expo-export-*/
himnario/.expo-verify-export/

# Native build folders (anchored with leading slash so nested modules/*/ios/ folders like apple-look-around are NEVER excluded)
/ios/
/android/
/himnario/ios/
/himnario/android/

# Audio recordings (streamed from Cloudflare R2 and cached on device)
himnario/assets/audio/
assets/audio/

# Secrets & local env files
.env
.env.*
.env.cloudflare
*.env
.dev.vars
.dev.vars.*
credentials.json
token.json
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.tsbuildinfo
